# ============================================================
# TRADING BOT CONFIG — Copy this file to .env and fill in
# NEVER commit .env to Git!
# ============================================================

# === MODE ===
PAPER_TRADING=true
ALGO_APPROVED=false   # Set true ONLY after broker gives written algo approval

# === CAPITAL & RISK ===
CAPITAL=100000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
DAILY_LOSS_LIMIT=0.03
RVOL_THRESHOLD=1.5

# === ZERODHA KITE (Fill only when going LIVE) ===
KITE_API_KEY=your_api_key_here
KITE_SECRET=your_secret_here
KITE_ACCESS_TOKEN=your_access_token_here

# === TELEGRAM (Optional — for trade alerts) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === TAX ===
TAX_SLAB_RATE=0.30
